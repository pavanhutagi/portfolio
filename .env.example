# for the contact and assistant features as they are added back.

# Contact form (SMTP)
EMAIL_USER=
EMAIL_PASSWORD=

# Assistant
GEMINI_API_KEY=

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
